process {
    withName: 'SUBREAD_FEATURECOUNTS_GENE_ID' {
        ext.args   = { [
            '-B -C',
            '-g gene_id',
            "-t $params.featurecounts_feature_type"
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/featurecounts/qc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FEATURECOUNTS_REPORT' {
        publishDir = [
            path: { "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/featurecounts/qc" },
            mode: params.publish_dir_mode
        ]
    }
}
