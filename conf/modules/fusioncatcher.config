process {
    withName: 'FUSIONCATCHER_FUSIONCATCHER' {
        publishDir = [
            [
                path: { "${params.outdir}/fusioncatcher" },
                mode: params.publish_dir_mode,
                pattern: "*.{fusion-genes.txt,summary.txt}"
            ],
            [
                path: { "${params.outdir}/fusioncatcher/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "{final-list*}"
            ],
            [
                path: { "${params.outdir}/fusioncatcher/log" },
                mode: params.publish_dir_mode,
                pattern: "*.log"
            ]
        ]
        containerOptions = '--bind /apps/OPENSSL/3.1.4/GCC/lib64:/opt/openssl3 --env LD_LIBRARY_PATH=/opt/openssl3'
    }
}
